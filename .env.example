# PostgreSQL connection string (e.g. from Vercel Postgres or Neon)
# Example: postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/moci_gym"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
# Set to your deployed URL in production, e.g. https://moci-gym.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# Optional: restrict self-registration to a specific email domain (leave blank to allow any)
ALLOWED_EMAIL_DOMAIN="moci.gov.qa"
